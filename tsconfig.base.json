{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ocpp/contracts": ["./packages/contracts/src/index.ts"],
      "@ocpp/contracts/*": ["./packages/contracts/src/*"],
      "@ocpp/ocpp": ["./packages/ocpp/src/index.ts"],
      "@ocpp/ocpp/*": ["./packages/ocpp/src/*"],
      "@ocpp/ui": ["./packages/ui/src/index.ts"],
      "@ocpp/ui/*": ["./packages/ui/src/*"],
      "@ocpp/mocks": ["./packages/mocks/src/index.ts"],
      "@ocpp/mocks/*": ["./packages/mocks/src/*"],
      "@ocpp/api-client": ["./packages/api-client/src/index.ts"],
      "@ocpp/api-client/*": ["./packages/api-client/src/*"]
    }
  }
}
